# Django Settings
DEBUG=False
SECRET_KEY={{ django_secret_key | default('change-me-in-production') }}
ALLOWED_HOSTS=*

# Database Configuration
DATABASE_URL=postgresql://{{ rds_username }}:{{ rds_password }}@{{ rds_endpoint }}/agrimarketdb

# CORS Settings
CORS_ALLOWED_ORIGINS=http://{{ ansible_default_ipv4.address }}:8080,http://localhost:8080

# Frontend URL
FRONTEND_URL=http://{{ ansible_default_ipv4.address }}:8080

# Email Configuration (optional)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# Superuser Configuration (for initial setup)
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=admin123
DJANGO_SUPERUSER_EMAIL=admin@agrimarket.local

# AWS Configuration
AWS_REGION={{ aws_region }}
ECR_REGISTRY={{ ecr_registry }}

# Application Settings
LOG_LEVEL=INFO
