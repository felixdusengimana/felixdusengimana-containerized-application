# Nginx reverse proxy - routes traffic to app server
upstream agrimarket_frontend {
    server {{ app_server_private_ip }}:3000;
}

upstream agrimarket_backend {
    server {{ app_server_private_ip }}:8000;
}

server {
    listen 3000;
    server_name _;

    location / {
        proxy_pass http://agrimarket_frontend;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_redirect off;
    }
}

server {
    listen 8000;
    server_name _;

    location / {
        proxy_pass http://agrimarket_backend;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_redirect off;
    }
}
